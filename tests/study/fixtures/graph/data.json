  "propositions": [
    {"op": "add", "id": "p_eq01", "statement": "An equation says two amounts are equal", "sources": [{"goal": "two-step-equations-k3f9", "log": "2026-10-21-a1b2", "step": "s1"}]},
    {"op": "add", "id": "p_bal2", "statement": "Doing the same thing to both sides keeps an equation true", "sources": [{"goal": "two-step-equations-k3f9", "log": "2026-10-21-a1b2", "step": "s1"}]},
    {"op": "alias", "id": "p_bal2", "text": "Whatever you do to one side, do to the other"},
    {"op": "add", "id": "p_inv1", "statement": "Addition and subtraction undo each other", "sources": [{"source": "src_n0t3"}]},
    {"op": "add", "id": "p_inv2", "statement": "Multiplication and division undo each other", "sources": [{"source": "src_n0t3"}]},
    {"op": "source", "id": "p_inv1", "source": {"goal": "two-step-equations-k3f9", "log": "2026-10-21-a1b2", "step": "s2"}},
    {"op": "add", "id": "p_last", "statement": "Undo the last operation done to x first", "sources": [{"goal": "two-step-equations-k3f9", "log": "2026-10-21-a1b2", "step": "s2"}]},
    {"op": "add", "id": "p_sub3", "statement": "Subtracting b from both sides of ax + b = c gives ax = c - b", "sources": [{"goal": "two-step-equations-k3f9", "log": "2026-10-23-c3d4", "step": "s3"}]},
    {"op": "add", "id": "p_div4", "statement": "Dividing both sides of ax = c - b by a gives x = (c - b) / a", "sources": [{"goal": "two-step-equations-k3f9", "log": "2026-10-23-c3d4", "step": "s3"}]},
    {"op": "alias", "id": "p_div4", "text": "x = (c - b) / a"},
    {"op": "add", "id": "p_gone", "statement": "Dividing by zero is fine if you are careful", "sources": [{"goal": "two-step-equations-k3f9", "log": "2026-10-23-c3d4", "step": "s3"}]},
    {"op": "delete", "id": "p_gone"},
    {"op": "add", "id": "p_co2", "statement": "Leaves take in carbon dioxide from the air", "sources": [{"goal": "how-plants-make-sugar-m2x8", "log": "2026-10-24-e5f6", "step": "s1"}]},
    {"op": "add", "id": "p_h2o", "statement": "Roots take up water from the soil", "sources": [{"goal": "how-plants-make-sugar-m2x8", "log": "2026-10-24-e5f6", "step": "s1"}]},
    {"op": "add", "id": "p_lite", "statement": "Chlorophyll absorbs light energy", "sources": [{"goal": "how-plants-make-sugar-m2x8", "log": "2026-10-24-e5f6", "step": "s2"}]},
    {"op": "add", "id": "p_split", "statement": "Light energy splits water, which releases oxygen", "sources": [{"goal": "how-plants-make-sugar-m2x8", "log": "2026-10-24-e5f6", "step": "s2"}]},
    {"op": "add", "id": "p_sugr", "statement": "Plants build sugar from carbon dioxide and the hydrogen from water", "sources": [{"goal": "how-plants-make-sugar-m2x8", "log": "2026-10-24-e5f6", "step": "s3"}]},
    {"op": "alias", "id": "p_sugr", "text": "Sugar's carbon comes from the air, not the soil"},
    {"op": "add", "id": "p_rate", "statement": "Oxygen after h hours = rate x h + oxygen at the start", "sources": [{"goal": "how-plants-make-sugar-m2x8", "log": "2026-10-24-e5f6", "step": "s4"}]},
    {"op": "add", "id": "p_hrs", "statement": "Hours to reach an amount of oxygen = (amount - start) / rate", "sources": [{"goal": "how-plants-make-sugar-m2x8", "log": "2026-10-24-e5f6", "step": "s4"}]},
