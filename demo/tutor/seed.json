   "feedback": [
    {
     "attempt": 1,
     "answer": "Sam forgot to add one",
     "text": "<p>You wrote \"Sam forgot to add one\". Trace it: flip <code>10000000</code> to get <code>01111111</code>, then add one to get <code>10000000</code>. Sam did add one.</p><p>So can 8 bits hold +128? (CS:APP 2.3.3)</p>"
    }
   ]
