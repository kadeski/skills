 {
  "op": "set",
  "collection": "lessons",
  "doc_id": "01",
  "data": {
   "title": "Where you're at",
   "kind": "lesson",
   "script": null,
   "pass": "You can now start on two's complement.",
   "html": "<h2>Where you're at</h2>\n<p>Two questions on what lesson 02 needs, then a guess.</p>\n<section id='Q1'><p><b>Q1.</b> Which bits are 13 in unsigned binary?</p></section>\n<section id='Q2'><p><b>Q2.</b> What is $2^7$?</p></section>\n<h2>Guess for next time (not graded)</h2>\n<section id='G'><p>In 8-bit two's complement, which number is <code>10000011</code>?</p></section>"
  }
 },
 {
  "op": "set",
