{
  "description": "Logs Study answers and the learner's words, and restores the lesson after compaction. Silent outside a Study session.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["-I", "${CLAUDE_PLUGIN_ROOT}/scripts/log_hook.py", "answer"],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["-I", "${CLAUDE_PLUGIN_ROOT}/scripts/log_hook.py", "prompt"],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["-I", "${CLAUDE_PLUGIN_ROOT}/scripts/log_hook.py", "compact"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
